diff --git a/client/packages/editor-oss/src/userManagement/playerProfile/game-service-controllers/MobileGameServiceIdentity.ts b/client/packages/editor-oss/src/userManagement/playerProfile/game-service-controllers/MobileGameServiceIdentity.ts
