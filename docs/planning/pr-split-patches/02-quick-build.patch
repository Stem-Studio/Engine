+): THREE.Vector3[] {
+    const radius = Math.max(1, Math.min(8, Math.floor(options.radius ?? 1)));
+    const current = getGridUnit(origin, increment);
+    const anchor = options.anchor ? getGridUnit(options.anchor, increment) : current;
