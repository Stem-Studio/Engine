+    const objects: THREE.Object3D[] = [];
+    root.traverse(object => {
+        if (getQuickBuildMetadata(object)) {
+            objects.push(object);
+        }
+    });
+    return objects;
+}
+
+export function collectQuickBuildBakeObjects(root: THREE.Object3D | null | undefined): THREE.Object3D[] {
+    if (!root) return [];
