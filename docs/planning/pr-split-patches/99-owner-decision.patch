+const scriptFile = files.find(f => f.name.endsWith(".stemscript"));
+const folderFiles = files.filter(f => f !== scriptFile)
+    .map(f => ({name: f.name, mime: mimeFor(f.name), data: readFileSync(f.abs).toString("base64")}));
