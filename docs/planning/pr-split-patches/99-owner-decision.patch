+        if (e === ".DS_Store" || e === ".git") continue;
+        const abs = join(dir, e), rel = prefix ? `${prefix}/${e}` : e;
+        if (statSync(abs).isDirectory()) out.push(...walk(abs, rel));
+        else out.push({name: rel, abs});
+    }
+    return out;
+}
