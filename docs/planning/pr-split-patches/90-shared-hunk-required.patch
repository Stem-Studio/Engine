+      exitCADMode: vi.fn(() => {
+        app.editor.cadMode = false;
+      }),
+    },
+    on: vi.fn((key: string, handler: ((...args: any[]) => void) | null) => {
+      if (handler) handlers.set(key, handler);
+      else handlers.delete(key);
+    }),
+    call: vi.fn(),
+    emit: (key: string, ...args: any[]) => handlers.get(key)?.(...args),
+  };
+  global.app = app as any;
+  return app;
